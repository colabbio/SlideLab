/*
 * SlideLab Nextflow Configuration
 * 
 * Profiles:
 *   nextflow run main.nf -profile local    → Run on local machine
 *   nextflow run main.nf -profile k8s      → Run on Kubernetes
 *   nextflow run main.nf -profile gpu      → GPU-accelerated
 *   nextflow run main.nf -profile gcp      → Google Cloud Batch
 */

// ─── Default settings ────────────────────────────────────────────
process {
    container = 'slidelab:cpu'
    errorStrategy = 'retry'
    maxRetries = 2
    stageInMode = 'symlink' // Zero-copy linking for MedVFS virtual filesystem
}

// Docker is enabled by default
docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

// ─── Profiles ────────────────────────────────────────────────────
profiles {
    
    // Local execution (dev/testing)
    local {
        process {
            executor = 'local'
            cpus = 4
            memory = '8 GB'
        }
        docker.enabled = true
    }
    
    // Kubernetes execution
    k8s {
        process {
            executor = 'k8s'
            container = 'slidelab:cpu'
            cpus = 4
            memory = '8 GB'
            pod = [
                [label: 'app', value: 'slidelab'],
                [label: 'pipeline', value: 'wsi-preprocessing']
            ]
        }
        k8s {
            namespace = 'colabbio'
            serviceAccount = 'slidelab-sa'
            storageClaimName = 'slidelab-nf-work'
            storageMountPath = '/work'
        }
        docker.enabled = false
    }
    
    // GPU execution
    gpu {
        process {
            container = 'slidelab:gpu'
            containerOptions = '--gpus all'
        }
        params.device = 'cuda'
        docker.enabled = true
    }
    
    // K8s + GPU
    k8s_gpu {
        process {
            executor = 'k8s'
            container = 'slidelab:gpu'
            cpus = 4
            memory = '16 GB'
            accelerator = [request: 1, type: 'nvidia.com/gpu']
            pod = [
                [label: 'app', value: 'slidelab'],
                [label: 'pipeline', value: 'wsi-preprocessing'],
                [nodeSelector: 'gpu-type', value: 'nvidia-t4']
            ]
        }
        k8s {
            namespace = 'colabbio'
            serviceAccount = 'slidelab-sa'
            storageClaimName = 'slidelab-nf-work'
            storageMountPath = '/work'
        }
        params.device = 'cuda'
        docker.enabled = false
    }
    
    // Google Cloud Batch
    gcp {
        process {
            executor = 'google-batch'
            container = 'europe-west1-docker.pkg.dev/colabbio/slidelab/slidelab:cpu'
            machineType = 'n2-standard-8'
            disk = '200 GB'
        }
        google {
            project = 'colabbio'
            location = 'europe-west1'
        }
    }
    
    // CI/Test — minimal resources
    test {
        process {
            executor = 'local'
            cpus = 2
            memory = '4 GB'
        }
        params {
            tile_size = 128
            batch_size = 8
            magnification = 10
        }
    }
}

// ─── Reports ─────────────────────────────────────────────────────
report {
    enabled = true
    overwrite = true
    file = "${params.output_dir}/nextflow_report.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.output_dir}/nextflow_timeline.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.output_dir}/nextflow_trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,memory,time,duration,realtime,%cpu,%mem,rss'
}

// ─── Manifest ────────────────────────────────────────────────────
manifest {
    name = 'colabbio/slidelab'
    author = 'Lorenzo Olmo Marchal, ColabBio'
    description = 'WSI preprocessing pipeline for digital pathology'
    version = '1.0.0'
    nextflowVersion = '>=23.04'
    mainScript = 'main.nf'
    defaultBranch = 'main'
}
